NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# These match the local PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://app:change_me_dev_only@localhost:5432/appointment_saas?schema=public
DIRECT_URL=postgresql://app:change_me_dev_only@localhost:5432/appointment_saas?schema=public

# Required in production. Use a random string of at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=1d

# Used only by `npm run admin:create`.
SUPER_ADMIN_EMAIL=admin@apnadesk.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345
SUPER_ADMIN_NAME=Super Admin
